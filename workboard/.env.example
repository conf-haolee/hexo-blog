# Local development
WORKBOARD_HOST=127.0.0.1
WORKBOARD_PORT=5000
WORKBOARD_AUTH_MODE=local
WORKBOARD_DATA_DIR=./data
WORKBOARD_DOCS_DIR=./data/docs
WORKBOARD_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
WORKBOARD_AGENT_TOKEN=replace-with-a-long-random-token

# Production behind Cloudflare Access
# WORKBOARD_HOST=0.0.0.0
# WORKBOARD_AUTH_MODE=cloudflare
# WORKBOARD_ALLOWED_EMAILS=your-email@example.com
# WORKBOARD_ALLOWED_ORIGINS=https://www.cvhao.top
# WORKBOARD_DATA_DIR=/app/data
# WORKBOARD_DOCS_DIR=/app/data/docs

